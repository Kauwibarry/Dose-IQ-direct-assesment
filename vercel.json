{
  "rewrites": [
    {
      "source": "/:lang(en|de|fr|it|es|pt|nl|pl|cs)/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/:lang(en|de|fr|it|es|pt|nl|pl|cs)/contact.html",
      "destination": "/contact.html"
    },
    {
      "source": "/:lang(en|de|fr|it|es|pt|nl|pl|cs)",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(en|de|fr|it|es|pt|nl|pl|cs)/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|mp4|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
